<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Karte 1904: der Tabellen-Bedienbereich pt:tableSettings als EIGENSTAENDIGES Artefakt -
        fuer Anwendungen, die plaintext-root-template/-common NICHT einbinden koennen (eigenes
        Theme, root v1, z. B. das Inventar mit dem Oblique-Theme und PrimeFaces 15).
        Karte 2086: das Paket ch.plaintext.boot.table (TableSettings, TableState, TableStateStore,
        die Texte) WOHNT hier und nur hier - plaintext-root-common haengt von diesem Artefakt ab,
        statt eine zweite Kopie zu kompilieren. Die Ablage UserPreferenceTableStateStore bleibt in
        root-common (Paket ch.plaintext.boot.tablestore, per AutoConfiguration und nur ohne eigene
        TableStateStore-Bean der App).
          - Tag + JS + CSS kommen unveraendert aus plaintext-root-template (einzige Quelle)
          - eigenes Taglib (META-INF/plaintext-tablesettings.taglib.xml) im Namensraum
            http://plaintext.ch/ui - Mojarra fuehrt Taglibs mit gleichem Namensraum zusammen.
            In root-v2-Apps liegt das Tag damit zweimal im Klassenpfad (Template und dieses JAR),
            byte-gleich aus derselben Quelle; Mojarra nimmt das erste, beide sind dasselbe.
        Alle Abhaengigkeiten sind provided: die Anwendung bringt PrimeFaces (15 oder 16), Faces,
        Jackson und slf4j selbst mit. Keine Abhaengigkeit auf root (auch nicht auf StabileApi).
    -->
    <parent>
        <groupId>ch.plaintext.v2</groupId>
        <artifactId>plaintext-root-parent</artifactId>
        <version>3.31.0-SNAPSHOT</version>
    </parent>

    <artifactId>plaintext-root-tablesettings</artifactId>
    <name>plaintext-root-tablesettings</name>
    <description>pt:tableSettings: ch.plaintext.boot.table (einzige Heimat), Tag, JS, CSS - ohne root-Abhaengigkeit</description>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish</groupId>
            <artifactId>jakarta.faces</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.primefaces</groupId>
            <artifactId>primefaces</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Wie in plaintext-root-common: FacesContext loest EL ueber den BeanManager auf, seit
             CDI 4.1 liegt ELAwareBeanManager im getrennten cdi-el-api. provided, die App bringt sie. -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-el-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- EL fuer die Tests (in root-common kommt sie ueber Spring Boot herein). -->
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-el</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Tests: junit, mockito, assertj, spring-test (ReflectionTestUtils) - nur test-scope. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <!-- Tag, JS und CSS unveraendert aus plaintext-root-template (einzige Quelle). -->
            <resource>
                <directory>${project.basedir}/../plaintext-root-template/src/main/resources</directory>
                <filtering>false</filtering>
                <includes>
                    <include>META-INF/tags/tableSettings.xhtml</include>
                    <include>META-INF/resources/plaintext-layout/js/table-settings.js</include>
                    <include>META-INF/resources/plaintext-layout/css/table-settings.css</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Nur Lombok: das Paket traegt keine @ModulApi, der Katalog-Prozessor des
                         Parents wird hier nicht gebraucht (und ist kein Reaktor-Vorgaenger). -->
                    <annotationProcessorPaths combine.self="override">
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs combine.self="override"/>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
